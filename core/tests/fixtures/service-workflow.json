            "Confirmation commits a reviewed request exactly once."
          ],
          "data sets": {
            "Request": {
              "Reference": {
                "description": "A human-readable request reference",
                "type": "text",
                "required": true,
                "minimum length": 2,
                "maximum length": 24,
                "example": "Sample request"
              },
              "Quantity": {
                "description": "Units of capacity",
                "type": "whole number",
                "required": true,
                "minimum": 1,
                "maximum": 8,
                "example": 2
              },
              "Credit": {
                "description": "Optional account credit",
                "type": "number",
                "minimum": 0,
                "maximum": 100.5,
                "example": 10.5
              }
            },
            "Cancellation": {
              "Reason": {
                "description": "The reason for cancellation",
                "type": "choice",
                "required": true,
                "options": [
                  "Changed plans",
                  "Duplicate request"
                ],
                "example": "Changed plans"
              },
              "Note": {
                "description": "Optional cancellation note preserved verbatim",
                "type": "text",
                "trim spaces": false,
                "maximum length": 40,
                "example": "Retain spaces"
              }
            },
            "Account": {
              "Email": {
                "description": "Contact address for service notices",
                "type": "email",
                "required": true,
                "minimum length": 8,
                "maximum length": 40,
                "example": "reader@example.test"
              },
              "Preference": {
                "description": "Preferred notification channel",
                "type": "choice",
                "options": [
                  "Email",
                  "None"
                ],
                "example": "Email"
              }
            }
          },
          "coverage": {
            "edges": 100,
            "states": 100
          }
        }
