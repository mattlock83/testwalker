{
  "name": "@testwalker/web",
  "version": "4.0.0",
  "private": true,
  "description": "Playwright and Jev adapter for Testwalker's Rust JSON-RPC framework",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./adapter": "./bin/adapter.js"
  },
  "bin": {
    "testwalker-web": "./bin/cli.js",
    "testwalker-web-adapter": "./bin/adapter.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "tsc --project tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "@testwalker/core": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
